{
  "name": "preview-suite",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/serve.js",
    "lint": "eslint js scripts tests && prettier --check js scripts tests package.json vercel.json eslint.config.js",
    "format": "prettier --write js scripts tests package.json vercel.json eslint.config.js",
    "test": "node --test tests/*.test.cjs && node tests/browser.cjs",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "marked": "12.0.2",
    "mermaid": "12.2.0",
    "prismjs": "1.30.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  }
}
